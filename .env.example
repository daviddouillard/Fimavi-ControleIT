# Copier en .env (jamais commité) et renseigner les valeurs.
# En production (Cloud Run), ces valeurs viennent de GCP Secret Manager.

# Secret de scellement des sessions (>= 32 caractères) : openssl rand -base64 32
NUXT_APP_SECRET=change-me-with-at-least-32-random-characters

# App registration Entra ID multi-locataire : connexion OIDC, annuaire (User.Read.All), SharePoint (Sites.Read.All).
# TENANT = tenant principal (seuls ses comptes peuvent être administrateurs).
NUXT_OAUTH_MICROSOFT_TENANT=00000000-0000-0000-0000-000000000000
NUXT_OAUTH_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
NUXT_OAUTH_MICROSOFT_CLIENT_SECRET=change-me
NUXT_OAUTH_MICROSOFT_REDIRECT_URL=http://localhost:3000/auth/microsoft

# Valeur de l'app role Entra des administrateurs IT (selon la nomenclature interne)
NUXT_ADMIN_ROLE=change-me

# PostgreSQL (Cloud SQL en production) — rôle applicatif aux droits restreints
NUXT_DATABASE_URL=postgres://controleit_app:change-me@localhost:5432/controleit
# Rôle propriétaire, utilisé uniquement par `npm run db:migrate` (jamais par l'application)
DATABASE_MIGRATION_URL=postgres://controleit_owner:change-me@localhost:5432/controleit

# Boîte d'envoi des emails aux valideurs (Mail.Send limité à cette boîte côté Exchange)
NUXT_MAIL_SENDER=helpdesk@example.com
